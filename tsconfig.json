{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "SpotiKit.React.createElement",
    "jsxFragmentFactory": "SpotiKit.React.Fragment"
  },
  "include": ["src", "spotikit.d.ts"]
}
